# 서버
PORT=3000
BASE_URL=http://localhost:3000
DB_PATH=data/withmj.db
TZ_SEND_HOUR_DEFAULT=21

# 운영자(우리) 계정 — 최초 실행 시 자동 생성
ADMIN_EMAIL=admin@withmj.kr
ADMIN_PASSWORD=change-me

# 카카오 알림톡 (mock | solapi). mock 이면 실제 발송 없이 발송 로그만 남김
KAKAO_PROVIDER=mock
SOLAPI_API_KEY=
SOLAPI_API_SECRET=
SOLAPI_PF_ID=
SOLAPI_TEMPLATE_ID=
SOLAPI_SENDER_PHONE=

# 결제 (mock | toss). mock 이면 billingKey 가 있으면 항상 결제 성공 처리
PAYMENT_PROVIDER=mock
TOSS_SECRET_KEY=

# 영업 리스트업 — 네이버 검색 API (지역 검색)
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=
